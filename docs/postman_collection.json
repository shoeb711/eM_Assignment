{
  "info": {
    "name": "eMinds PMO Portal API",
    "description": "Run the folders in order. Postman keeps the session cookie after each login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    }
  ],
  "item": [
    {
      "name": "1 - Contributor is denied (acceptance test D)",
      "item": [
        {
          "name": "Login as Contributor (Chen Wei)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chen.wei@demo.local\",\n  \"password\": \"Demo@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "My projects (only 4 visible)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('only member projects', () => pm.expect(pm.response.json().total).to.eql(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Open a project I am not on -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('hidden project', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Post a cost directly -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/2/costs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "2",
                "costs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"description\": \"Trying to post\",\n  \"amount\": 500,\n  \"txnDate\": \"2026-09-20\",\n  \"post\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('contributor cannot post costs', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve a change request directly -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/change-requests/5/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "change-requests",
                "5",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\",\n  \"reason\": \"Trying to approve\",\n  \"version\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('contributor cannot approve', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my own task progress -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks?mine=true&status=IN_PROGRESS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "mine",
                  "value": "true"
                },
                {
                  "key": "status",
                  "value": "IN_PROGRESS"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed my tasks', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Project Manager posts a cost (journey 4)",
      "item": [
        {
          "name": "Login as Project Manager (Priya Nair)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.nair@demo.local\",\n  \"password\": \"Demo@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Finance summary PRJ-002 (before)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/2/finance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "2",
                "finance"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Post a cost",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/2/costs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "2",
                "costs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 2,\n  \"description\": \"Licence top-up\",\n  \"amount\": 12500,\n  \"txnDate\": \"2026-09-20\",\n  \"post\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cost posted', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Finance summary PRJ-002 (after)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/2/finance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "2",
                "finance"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Drill-down: posted costs up to 30 Sep",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/costs?projectId=2&status=POSTED&to=2026-09-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "costs"
              ],
              "query": [
                {
                  "key": "projectId",
                  "value": "2"
                },
                {
                  "key": "status",
                  "value": "POSTED"
                },
                {
                  "key": "to",
                  "value": "2026-09-30"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Admin",
      "item": [
