{
  "name": "eminds-server",
  "version": "1.0.0",
  "private": true,
  "description": "Project Portfolio & Financial Control Portal - Express API",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:generate": "node seed/generate.js",
    "db:import": "node seed/import.js",
    "db:seed": "npm run db:generate && npm run db:import",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.9.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
