# Copy this file to "server/.env". Must match the values in the root .env file.
DATABASE_URL="postgresql://pmo:change_me@localhost:5433/pmo_portal"

# API port (the React dev server forwards /api requests here)
PORT=4000

# Secret used to sign login tokens - use a long random string
JWT_SECRET="replace-with-a-long-random-string"

# Fixed reporting date for the assignment's baseline demo (Section 6)
REPORTING_DATE="2026-09-30"

# Overdue-task automation: run every N minutes (0 = only when an admin clicks "Run now")
AUTOMATION_INTERVAL_MINUTES=5
